{
  "$id": "https://lol-event-semantics.local/schema/manifest.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contains_full_raw_event_index": {
      "const": true
    },
    "content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "content_digest_algorithm": {
      "const": "lol-event-semantics.content-digest.v1"
    },
    "content_identity": {
      "additionalProperties": true,
      "properties": {
        "base_game_version": {
          "minLength": 1,
          "type": "string"
        },
        "corpus_scope": {
          "minLength": 1,
          "type": "string"
        },
        "input_identity": {
          "type": "object"
        },
        "quality_status": {
          "const": "not_evaluated"
        },
        "review": {
          "type": "object"
        },
        "support_level_counts": {
          "type": "object"
        }
      },
      "required": [
        "input_identity",
        "corpus_scope",
        "base_game_version",
        "review",
        "support_level_counts",
        "quality_status"
      ],
      "type": "object"
    },
    "dataset_id": {
      "pattern": "^local-v1-[0-9a-f]{16}$",
      "type": "string"
    },
    "dataset_schema_version": {
      "const": "normalized-dataset.v2"
    },
    "entity_count": {
      "minimum": 0,
      "type": "integer"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "record_count": {
            "minimum": 0,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 7,
      "type": "array"
    },
    "normalized_record_schema_version": {
      "const": 2
    },
    "outputs": {
      "items": {
        "type": "string"
      },
      "minItems": 7,
      "type": "array",
      "uniqueItems": true
    },
    "pattern_catalog_schema_version": {
      "const": 1
    },
    "pattern_count": {
      "minimum": 0,
      "type": "integer"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "reference_version": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 2
    }
  },
  "required": [
    "schema_version",
    "dataset_schema_version",
    "normalized_record_schema_version",
    "pattern_catalog_schema_version",
    "dataset_id",
    "content_digest",
    "content_digest_algorithm",
    "content_identity",
    "files",
    "reference_version",
    "entity_count",
    "record_count",
    "pattern_count",
    "contains_full_raw_event_index",
    "outputs"
  ],
  "title": "lol-event-semantics normalized manifest v2",
  "type": "object"
}
